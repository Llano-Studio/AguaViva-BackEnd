POSTGRES_DB=sgarav_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=123456
POSTGRES_PORT=5434

PORT=3000
APP_URL=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:3000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/sgarav_db?schema=public&connection_limit=5
DATABASE_CONNECTION_LIMIT=5

JWT_SECRET=sgarav-secret-key
JWT_REFRESH_TOKEN_SECRET=sgarav-secret-key
CENTRAL_AUTH_JWT_SECRET=sgarav-secret-key
LOGIN_SERVICE_JWT_SECRET=sgarav-secret-key
CENTRAL_AUTH_ISSUER=login-service
CENTRAL_AUTH_SYSTEM_CODE=AGUAVIVA
MODULE_SYSTEM_CODE=AGUAVIVA

LOGIN_SERVICE_URL=http://login-service:3000
PUBLIC_LOGIN_SERVICE_URL=http://localhost:3001

# Motor de optimización de rutas (mock para desarrollo/QA).
# El mock no arranca en producción salvo ROUTE_OPTIMIZER_ALLOW_MOCK_IN_PRODUCTION=true.
ROUTE_OPTIMIZER_PROVIDER=mock
ROUTE_OPTIMIZER_ALLOW_MOCK_IN_PRODUCTION=false
# Depósito de la operación (si se omite, se usa el valor de BUSINESS_CONFIG).
ROUTE_DEPOT_LAT=
ROUTE_DEPOT_LNG=
ROUTE_RETURN_TO_DEPOT=true
# Parámetros de estimación del mock (distancias sin ruteo real).
ROUTE_MOCK_RADIUS_KM=6
ROUTE_AVERAGE_SPEED_KMH=30
ROUTE_SERVICE_MINUTES_PER_STOP=5
ROUTE_ROAD_FACTOR=1.3
